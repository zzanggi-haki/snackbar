# GitHub Releases API 호출용 (선택). 없으면 비인증 한도(시간당 60회)로 동작한다.
# 권한 없는 fine-grained 토큰(public repo read)이면 충분하다.
GITHUB_TOKEN=

# giscus (https://giscus.app 에서 발급). 네 값이 모두 있어야 댓글이 켜지고,
# 비어 있으면 GitHub Issues 링크로 대체된다.
NEXT_PUBLIC_GISCUS_REPO=
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
